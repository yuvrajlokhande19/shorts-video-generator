# ---- AI / LLM (script generation) ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id, e.g. gemini-2.0-flash, gemini-1.5-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash

# ---- Stock video (optional, free with signup) ----
# https://www.pexels.com/api/  (free tier)
PEXELS_API_KEY=
# https://pixabay.com/api/docs/ (free, requires key)
PIXABAY_API_KEY=

# ---- Movie Metadata (optional, free with signup) ----
# https://www.themoviedb.org/settings/api (free tier)
TMDB_API_KEY=
# http://www.omdbapi.com/apikey.aspx (free tier)
OMDB_API_KEY=

# If no stock API keys are provided the app generates free procedural
# background clips automatically. You can also drop your own .mp4 files
# into assets/clips/ and your own music into assets/music/ and they will
# be used instead.

# For movie splitter: if no TMDB/OMDB keys, it extracts title from filename.
# For best results, add TMDB_API_KEY for comprehensive movie database access.